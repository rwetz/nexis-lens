<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened runtime blocks the camera unless this is granted. Without it a
       signed + notarized build silently gets no video for gesture tracking. -->
  <key>com.apple.security.device.camera</key>
  <true/>
</dict>
</plist>
